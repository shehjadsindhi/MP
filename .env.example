# Database configuration
# For local development: DATABASE_PROVIDER=sqlite, DATABASE_URL=file:./dev.db
# For production PostgreSQL: change schema.prisma provider to "postgresql", set DATABASE_URL to postgres connection string
DATABASE_PROVIDER=sqlite
DATABASE_URL=

# Authentication JWT Secret (Minimum 32 random characters recommended)
JWT_SECRET=

# Initial Administrator Seed Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Application Base URL
NEXT_PUBLIC_APP_URL=

# Optional External AI API Keys (Used by interactive AI demos if configured)
GEMINI_API_KEY=
OPENAI_API_KEY=
