# Database configuration (Default is SQLite for zero-config local run; change to postgresql for PostgreSQL)
DATABASE_URL="file:./dev.db"

# Authentication JWT Secret
JWT_SECRET="your-jwt-secret-key-at-least-32-chars-long"

# Seed Admin Credentials
ADMIN_EMAIL="admin@galaxyai.hub"
ADMIN_PASSWORD="Admin@123456"

# Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional External AI API Key (e.g. OpenAI / Google Gemini if connecting real AI in production)
# GEMINI_API_KEY=""
# OPENAI_API_KEY=""
