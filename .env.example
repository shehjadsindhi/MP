# Database configuration
# For local development: DATABASE_PROVIDER=sqlite, DATABASE_URL=file:./dev.db
# For production PostgreSQL (RECOMMENDED: Neon, Supabase, Vercel Postgres):
#   - Neon:     DATABASE_URL="postgresql://user:pass@ep-xxx.us-east-1.aws.neon.tech/db?sslmode=require"
#   - Supabase: DATABASE_URL="postgresql://postgres:pass@db.xxx.supabase.co:5432/postgres?sslmode=require"
#   - Vercel:   DATABASE_URL="postgres://user:pass@region.pooler.supabase.com:5432/db?sslmode=require" (with PgBouncer)
#   - Local PG: DATABASE_URL="postgresql://user:pass@localhost:5432/galaxy_ai_hub?schema=public"
DATABASE_PROVIDER=postgresql
DATABASE_URL=

# Authentication JWT Secret (Minimum 32 random characters recommended)
JWT_SECRET=

# Initial Administrator Seed Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Application Base URL
NEXT_PUBLIC_APP_URL=
NEXTAUTH_URL=

# Optional External AI API Keys (Used by interactive AI demos if configured)
GEMINI_API_KEY=
OPENAI_API_KEY=

# Email Service (nodemailer)
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=
EMAIL_FROM=

# Error Monitoring (Sentry)
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=

# Redis Cache
REDIS_URL=

# Image Upload
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# Payment Providers
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PUBLISHABLE_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Backup
BACKUP_DIR=

